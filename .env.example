# At least one free AI key is recommended. Without any, the app falls back to a rule-based report.
# Groq (free tier, fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pro (full plan) gating.
# Unset: Pro is free until Razorpay keys are set, then it is paid.
# true: Pro is free for everyone. false: Pro needs payment (Razorpay) or an access code.
PRO_FREE_BETA=
# Comma separated access codes that unlock Pro in any mode (testers, comps).
PRO_ACCESS_CODES=

# Razorpay (India, UPI only): one-time payment per full report.
# Dashboard > Account & Settings > API Keys. Use rzp_test_... keys while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook https://YOUR_APP/api/razorpay/webhook (event: order.paid).
# With it, paid PDFs are emailed the moment payment completes, even if the buyer closes the tab.
RAZORPAY_WEBHOOK_SECRET=
# Price in paise (49900 = Rs 499).
PRO_PRICE_PAISE=49900
# Public URL of the app, used in emails and the PDF upsell link.
NEXT_PUBLIC_APP_URL=

# Email delivery via Resend (free: 3,000 emails/month). https://resend.com/api-keys
# When set, the free teardown requires an email and both reports are emailed as PDFs.
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Marketing Scholars <reports@yourdomain.com>".
EMAIL_FROM=
EMAIL_REPLY_TO=

# A/B test analytics (optional). Events always go to Vercel logs; with a key they
# are also sent to PostHog (free tier). https://posthog.com > Project settings.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
