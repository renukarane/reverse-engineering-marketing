# At least one free AI key is recommended. Without any, the app falls back to a rule-based report.
# Groq (free tier, fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pro (full plan) gating.
# Unset: Pro is free until STRIPE_SECRET_KEY is set, then it is paid.
# true: Pro is free for everyone. false: Pro needs payment (Stripe) or an access code.
PRO_FREE_BETA=
# Comma separated access codes that unlock Pro in any mode (testers, comps).
PRO_ACCESS_CODES=

# Stripe: one-time payment per full report. https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=
# Price in US cents (1900 = $19), used when STRIPE_PRICE_ID is empty.
PRO_PRICE_CENTS=1900
# Optional: a Price you created in the Stripe dashboard instead of PRO_PRICE_CENTS.
STRIPE_PRICE_ID=
# Optional: let Stripe Tax calculate US sales tax (enable Stripe Tax in the dashboard first).
STRIPE_AUTOMATIC_TAX=false
# Public URL of the app, used for Stripe redirect URLs and the PDF upsell link.
NEXT_PUBLIC_APP_URL=

# Requests per IP per hour.
RATE_LIMIT_PER_HOUR=10

# Any OpenAI-compatible endpoint (e.g. Ollama at http://localhost:11434/v1). Tried last.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
