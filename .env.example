# At least one free AI key is recommended. Without any, the app falls back to a rule-based report.
# Groq (free tier, fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pro (full plan) gating. While true, Pro is free for everyone (beta).
PRO_FREE_BETA=true
# Comma separated access codes that unlock Pro when PRO_FREE_BETA=false.
PRO_ACCESS_CODES=

# Requests per IP per hour.
RATE_LIMIT_PER_HOUR=10

# Any OpenAI-compatible endpoint (e.g. Ollama at http://localhost:11434/v1). Tried last.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
